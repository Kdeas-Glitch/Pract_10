<Page x:Class="Pract10.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pract10.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <ListView Grid.Column="0" ItemsSource="{Binding list}" SelectedItem="{Binding cur}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Proc}"></TextBlock>
                        <TextBlock Text="{Binding Vram}"></TextBlock>
                        <TextBlock Text="{Binding Accumulator}"></TextBlock>
                        <TextBlock Text="{Binding Video}"></TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Column="1">

            <Button Click="Create">Создать конфигурацию</Button>
            <Button Click="Copy">Скопировать конфигурацию</Button>
            <Button Click="CopyCreate">Скопировать и изменить конфигурацию</Button>

        </StackPanel>
    </Grid>
</Page>
