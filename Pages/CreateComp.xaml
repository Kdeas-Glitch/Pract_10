<Page x:Class="Pract10.Pages.CreateComp"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pract10.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CreateComp">

    <Grid>
        <StackPanel>
            <StackPanel>
                <TextBlock>Процессор:</TextBlock>
                <ComboBox SelectedIndex="{Binding curProc}" SelectionChanged="ProcSelect">
                    <ComboBoxItem>intel</ComboBoxItem>
                    <ComboBoxItem>amd</ComboBoxItem>
                </ComboBox>
            </StackPanel>

            <StackPanel Name="Stack1" Visibility="Hidden">
                <TextBlock>Объем оперативной памяти:</TextBlock>
                <ComboBox SelectedIndex="{Binding curVram}" SelectionChanged="VramSelect" >
                    <ComboBoxItem>8 битов</ComboBoxItem>
                    <ComboBoxItem>1 КилоБайт</ComboBoxItem>
                </ComboBox>
            </StackPanel>

            <StackPanel Name="Stack2" Visibility="Hidden">
                <TextBlock>Накопитель:</TextBlock>
                <ComboBox SelectedIndex="{Binding curAcum}" SelectionChanged="AcumSelect">
                    <ComboBoxItem>SSD</ComboBoxItem>
                    <ComboBoxItem>HDD</ComboBoxItem>
                </ComboBox>
            </StackPanel>
            <StackPanel Name="Stack3" Visibility="Hidden">
                <TextBlock>Видео карта:</TextBlock>
                <ComboBox SelectedIndex="{Binding curVideo}" SelectionChanged="VideoSelect">
                    <ComboBoxItem>GeForce</ComboBoxItem>
                    <ComboBoxItem>Radeon</ComboBoxItem>
                </ComboBox>
            </StackPanel>

            <Button Name="Buttton" Click="Create" Visibility="Hidden">Создать конфигурацию</Button>
            <Button Click="Back">Назад</Button>
        </StackPanel>
    </Grid>
</Page>
